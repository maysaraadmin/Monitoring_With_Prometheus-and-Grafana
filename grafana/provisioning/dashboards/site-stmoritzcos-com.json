{
  "uid": "stmoritzcos-com",
  "title": "stmoritzcos.com",
  "description": "Dedicated dashboard for https://stmoritzcos.com, generated by scripts/make-site-dashboards.py -- edit websites.json and re-run rather than editing this file. For every site at once, see the \"Website Monitoring\" dashboard (uid website-monitoring).",
  "tags": [
    "blackbox",
    "websites",
    "stmoritzcos.com"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Status",
      "description": "probe_success. The word is the signal; the colour only repeats it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{instance=\"https://stmoritzcos.com\"}",
          "instant": true,
          "legendFormat": "status",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "not probed",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Uptime, selected range",
      "description": "avg_over_time(probe_success) across the dashboard time range. 100% here only means every probe in range succeeded -- gaps where this machine was off are not counted as downtime. See docs/Decisions.md D-014.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time(probe_success{instance=\"https://stmoritzcos.com\"}[$__range]) * 100",
          "instant": true,
          "legendFormat": "uptime",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "HTTP status",
      "description": "probe_http_status_code. 0 means the request never completed -- DNS, connection or timeout, not a server reply.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_status_code{instance=\"https://stmoritzcos.com\"}",
          "instant": true,
          "legendFormat": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "no reply",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "TLS certificate expires in",
      "description": "Days until the earliest certificate in the chain expires. A negative value means it already has. Only present for targets that actually serve TLS -- an http:// URL that redirects to HTTPS will show one. Blank means no probe has succeeded in the range, so the certificate could not be read -- it does not mean the site has no certificate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(probe_ssl_earliest_cert_expiry{instance=\"https://stmoritzcos.com\"} - time()) / 86400",
          "instant": true,
          "legendFormat": "days",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "noValue": "unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Failed probes, selected range",
      "description": "How many probes did not succeed in the selected range. This is the headline number: a site can look UP right now and still have failed repeatedly today.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time((probe_success{instance=\"https://stmoritzcos.com\"} == 0)[$__range:30s])",
          "legendFormat": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Median response",
      "description": "quantile_over_time(0.5). Half of all probes were faster than this. Compare with p95 below: if they are far apart the site is inconsistent, which users feel more than a slow average.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.5, probe_duration_seconds{instance=\"https://stmoritzcos.com\"}[$__range])",
          "legendFormat": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "95th percentile",
      "description": "19 out of 20 probes were faster than this. This is closer to the worst experience a real visitor gets than the median is.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, probe_duration_seconds{instance=\"https://stmoritzcos.com\"}[$__range])",
          "legendFormat": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Status flips",
      "description": "How many times the site changed between UP and DOWN in the range. A high number means flapping -- intermittently unreachable -- which is harder to diagnose and often worse for users than being cleanly down.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(probe_success{instance=\"https://stmoritzcos.com\"}[$__range])",
          "legendFormat": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Connection-level failures",
      "description": "Probes that got NO HTTP reply -- the connection was refused, dropped or timed out before the server said anything. A run of these usually means a firewall is blocking this machine (rate limiting, fail2ban, CSF) or the host is unreachable. It does NOT mean the site is broken for everyone: check from another network before assuming an outage.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time((probe_http_status_code{instance=\"https://stmoritzcos.com\"} == 0)[$__range:30s])",
          "instant": true,
          "legendFormat": "v",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Replied, then failed",
      "description": "Probes where the server DID start replying but the probe still failed. Two causes, both the server's: a status outside 200-399 (a 500, 403 or WAF rejection), or -- more often -- a 200 that could not finish transferring before the scrape timeout cut it off. The second case means the page starts arriving and then crawls, which page weight alone rarely explains. If this is high while connection-level failures are 0, the host is reachable but struggling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count_over_time((probe_success{instance=\"https://stmoritzcos.com\"} == 0 and probe_http_status_code{instance=\"https://stmoritzcos.com\"} > 0)[$__range:30s])",
          "instant": true,
          "legendFormat": "v",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Slowest response",
      "description": "The worst single probe in the range. If this sits at a flat number equal to the scrape timeout (20s for this job), those probes did not finish -- they were cut off, so the real figure is 'at least this'. Compare with the median: a large gap means the site is inconsistent rather than uniformly slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max_over_time(probe_duration_seconds{instance=\"https://stmoritzcos.com\"}[$__range])",
          "instant": true,
          "legendFormat": "v",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Fastest response",
      "description": "The best single probe in the range. This is what the site is capable of when nothing is in the way, so it is the realistic target for the median. A low number here with a high median means the slowness is intermittent, not structural.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min_over_time(probe_duration_seconds{instance=\"https://stmoritzcos.com\"}[$__range])",
          "instant": true,
          "legendFormat": "v",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "state-timeline",
      "title": "Availability over time",
      "description": "One band per probe result. Blank stretches are periods with no data at all -- this machine was off, not the site. That distinction is the whole point of showing it this way rather than as a line at zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{instance=\"https://stmoritzcos.com\"}",
          "legendFormat": "availability",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Total response time",
      "description": "probe_duration_seconds -- the whole probe, end to end. One series, so no legend: the title names it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{instance=\"https://stmoritzcos.com\"}",
          "legendFormat": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "no data",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Where the time goes",
      "description": "The same request broken into its phases: DNS resolve, TCP connect, TLS handshake, server processing, transfer. Stacked, so the top of the stack is the total. This is the panel that tells you WHY a site got slow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_http_duration_seconds{instance=\"https://stmoritzcos.com\"}",
          "legendFormat": "{{phase}}",
