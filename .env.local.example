# Copy to .env.local and set a real password. .env.local is gitignored.
# Grafana only reads GF_SECURITY_ADMIN_PASSWORD when it first initialises its
# database. If grafana_data already exists, this value is IGNORED on startup --
# change the password through the API instead. See docs/Test_scenarios.md T1.S2.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
