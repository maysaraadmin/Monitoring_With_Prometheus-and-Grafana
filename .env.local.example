# ---------------------------------------------------------------------------
# THIS IS A TEMPLATE. IT IS NOT READ BY ANYTHING.
#
# The live file is .env.local (gitignored). This file exists only so a fresh
# checkout knows which variables to set:
#
#     cp .env.local.example .env.local
#     # then edit .env.local and set a real password
#
# To see the password actually in use:
#     grep GF_SECURITY_ADMIN_PASSWORD .env.local
#
# Grafana only reads GF_SECURITY_ADMIN_PASSWORD when it FIRST initialises its
# database. If the grafana_data volume already exists, editing it here or in
# .env.local changes nothing -- you must also reset it inside the container:
#
#     docker exec -it grafana grafana-cli admin reset-admin-password '<new>'
#
# Keep .env.local and the running password in step, or deleting grafana_data
# later will silently revert to whatever .env.local says.
# See docs/Test_scenarios.md T1.S2 and docs/Handoff.md (Sprint 1).
#
# Note: Grafana blocks a user for ~5 minutes after 5 failed logins. If a
# correct password is being rejected, check `docker logs grafana` for
# "login for user temporarily blocked" before assuming the password is wrong.
# ---------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=PUT-A-REAL-PASSWORD-IN-.env.local-NOT-HERE
